{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "internshipfeed.api:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/:view(listings|feed|recommendations|saved|applied|dismissed|profile)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
