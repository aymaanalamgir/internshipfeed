# Template for local database, production cron, and optional downstream email settings.
# Production: set DATABASE_URL to the Neon direct/unpooled PostgreSQL URL in Vercel.
DATABASE_URL=postgresql://internshipfeed:internshipfeed@127.0.0.1:5432/internshipfeed
CRON_SECRET=

# Optional daily email; missing credentials never prevent ingestion.
DAILY_NOTIFICATION_CHANNEL=email
RESEND_API_KEY=
DAILY_EMAIL_FROM=
DAILY_EMAIL_TO=
DAILY_EMAIL_MIN_SCORE=60
DAILY_EMAIL_TOP_N=5
# Optional public app URL for the digest footer.
APP_BASE_URL=
