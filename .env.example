# Template for database and daily email settings; keep real values in the ignored .env file.
DATABASE_URL=postgresql://internshipfeed:internshipfeed@127.0.0.1:5432/internshipfeed

# Daily email (sender must be verified in Resend; dry runs need no credentials).
DAILY_NOTIFICATION_CHANNEL=email
RESEND_API_KEY=
DAILY_EMAIL_FROM=
DAILY_EMAIL_TO=
DAILY_EMAIL_MIN_SCORE=60
DAILY_EMAIL_TOP_N=5
# Optional public app URL for the digest footer.
APP_BASE_URL=
