# Exclude local environments, credentials, generated assets, and runtime data.
__pycache__/
*.py[cod]
*.egg-info/
build/
.venv/
.vercel/
data/
.env
.env.*
!.env.example
node_modules/
frontend/dist/
*.tsbuildinfo
.neon

# Exclude screenshots, editor backups, and disposable tool caches.
screenshots/
.DS_Store
Thumbs.db
*.bak
*.orig
*.swp
*.swo
.pytest_cache/
.mypy_cache/
.ruff_cache/
